wait_sync 4
move 100,R5
ramp_idle:
wait 20004
loop R5,@ramp_idle
wait 4
frame_loop:
move 0,R0
move 8,R3
x_loop_a:
move 8,R4
y_loop_a:
wait 1004
acquire 0,R0,1000
add R0,1,R0
loop R4,@y_loop_a
loop R3,@x_loop_a
move 0,R0
move 8,R3
x_loop_b:
move 8,R4
y_loop_b:
wait 1004
acquire 1,R0,1000
add R0,1,R0
loop R4,@y_loop_b
loop R3,@x_loop_b
jmp @frame_loop